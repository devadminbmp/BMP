<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>in.bemyprofessional</groupId>
  <artifactId>bmp-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>BMP Platform (microservices, Session 5)</name>
  <description>
    Be My Professional — 11 independently-deployable Spring Boot services (9 business/auth
    services + eureka-server + api-gateway), one shared PostgreSQL instance (schema per
    service). Formerly a modular monolith (see bmp-app/RETIRED.md) — pivoted to
    microservices in Session 5. NOTE: this reversal was made with only one of the 3
    founders present; see CONTEXT.md Session 5 log for the full flag.
  </description>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <spring-modulith.version>1.3.1</spring-modulith.version>
    <archunit.version>1.3.0</archunit.version>
    <!-- Session 5: microservices pivot — Spring Cloud 2024.0.0 ("Moorgate") is the
         release line compatible with Spring Boot 3.4.x, needed for Eureka + Gateway. -->
    <spring-cloud.version>2024.0.0</spring-cloud.version>
    <jjwt.version>0.12.6</jjwt.version>
    <!-- Session 44: image upload. The AWS SDK is used to talk to MinIO in dev and to real
         S3/R2/Spaces in production — all of which speak the S3 API, which is the entire reason
         this is the SDK rather than a MinIO-specific client. Swapping providers is four config
         values in bmp-salon's application.yml, not a dependency change. -->
    <aws-sdk.version>2.28.16</aws-sdk.version>
  </properties>

  <modules>
    <module>bmp-common</module>
    <module>bmp-user</module>
    <module>bmp-salon</module>
    <module>bmp-booking</module>
    <module>bmp-payment</module>
    <module>bmp-review</module>
    <module>bmp-rewards</module>
    <module>bmp-admin</module>
    <module>bmp-notification</module>
    <module>bmp-auth</module>
    <module>eureka-server</module>
    <module>api-gateway</module>
    <module>bmp-config-server</module>
    <module>bmp-monitoring</module>
    <!-- bmp-app REMOVED from active build — Session 5 pivot to microservices means
         there is no longer "one deployable"; each bmp-* module below is now its own
         independently-buildable, independently-runnable Spring Boot service. The old
         bmp-app/ directory is left in place (not deleted) as a historical record of the
         monolith entry point; see bmp-app/RETIRED.md. -->
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Session 44: BOM so every module agrees on one AWS SDK version. The SDK's modules
           are tightly coupled to each other; mixing versions produces NoSuchMethodError at
           runtime rather than a build failure, which is the worst place to find out. -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- internal modules -->
      <dependency><groupId>in.bemyprofessional</groupId><artifactId>bmp-common</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>in.bemyprofessional</groupId><artifactId>bmp-user</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>in.bemyprofessional</groupId><artifactId>bmp-salon</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>in.bemyprofessional</groupId><artifactId>bmp-booking</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>in.bemyprofessional</groupId><artifactId>bmp-payment</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>in.bemyprofessional</groupId><artifactId>bmp-review</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>in.bemyprofessional</groupId><artifactId>bmp-rewards</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>in.bemyprofessional</groupId><artifactId>bmp-admin</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>in.bemyprofessional</groupId><artifactId>bmp-notification</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>in.bemyprofessional</groupId><artifactId>bmp-auth</artifactId><version>${project.version}</version></dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- every module gets these -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- version managed by spring-boot-starter-parent's BOM -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        ═══════════════════════════════════════════════════════════════════════════════════
        Session 42 — Lombok, declared explicitly. THIS IS WHY THE BUILD WAS FAILING.
        ═══════════════════════════════════════════════════════════════════════════════════
        A local build produced 100 errors (javac's default `-Xmaxerrs` — it stopped counting,
        it didn't stop there). Every single one traced to ONE cause:

            cannot find symbol: method getId()
            location: variable b of type com.bmp.booking.entities.Booking

        `Booking` is `@Getter` with per-field `@Setter`, and its only hand-written methods are
        `touch()` and `applyDiscount()`. So `getId`, `getBookingRef`, `getCustomerName`,
        `setOriginalStart` — all of them — are Lombok's. If Lombok doesn't run, none exist,
        and every caller fails at once.

        The knock-on is what made it look like a hundred different problems. Once javac has
        that many errors it reports downstream symbols as unresolved too, which is why the log
        also claimed `SlotLock`, `BookingEvents` and `com.bmp.booking.client.dto` were missing.
        All four are present on disk, in the right packages. They were collateral.

        WHY IT BROKE
        Lombok was declared only as a `provided` dependency. That makes it visible on the
        compile classpath and leaves javac to *discover* it as an annotation processor, which
        is exactly the fragile part: implicit discovery is affected by the JDK in use, by
        `-proc` defaults (JDK 21+ warns, and newer JDKs disable implicit processing outright),
        and by whether an IDE delegates to Maven or compiles with its own settings.

        Declaring it here removes the discovery step. The processor path is explicit, so the
        build behaves identically under `mvn`, under IntelliJ's delegated build, and in CI.
        `${lombok.version}` comes from spring-boot-starter-parent, so it stays pinned to the
        version Boot 3.4.1 was tested against.

        IF YOU ARE STILL SEEING IT IN INTELLIJ after this change, IntelliJ is compiling with
        its own builder rather than Maven. Two settings:
          · Settings > Build > Compiler > Annotation Processors > Enable annotation processing
          · Settings > Build > Build Tools > Maven > Runner > Delegate IDE build to Maven
        And check the Project SDK is 21 — Lombok 1.18.36 predates JDK 24/25 and will fail on
        them however it is configured.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!--
        ═══════════════════════════════════════════════════════════════════════════════════
        Session 39 — tests actually run now.
        ═══════════════════════════════════════════════════════════════════════════════════
        CI has said `-DskipTests` since Session 33. That was honest at the time (there were no
        tests to run) and it stopped being honest the moment there were.

        The reason it couldn't simply be removed: every module ships a Spring Boot generated
        `*ApplicationTests` with a `@SpringBootTest` context-load check. Those need PostgreSQL,
        Kafka and Eureka to be up. On a CI runner they fail — not because anything is wrong, but
        because there is no database — and a red build caused by missing infrastructure is the
        fastest way to teach a team to ignore red builds.

        So they are excluded here, by name, and everything else runs. What's left is pure logic:
        the cancellation-fee calculator, the booking state machine, Money's rounding, phone
        masking, and bmp-app's ArchUnit/Modulith rules (static analysis, no context needed).

        WHEN INFRASTRUCTURE EXISTS IN CI (Testcontainers, or a service container), delete this
        exclusion rather than adding a second profile. A context-load test that never runs is a
        test that has been quietly failing for months.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <!-- @SpringBootTest smoke tests: need a live database. -->
            <exclude>**/*ApplicationTests.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
