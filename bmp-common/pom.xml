<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>in.bemyprofessional</groupId>
    <artifactId>bmp-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>bmp-common</artifactId>
  <name>BMP :: common (shared kernel)</name>
  <description>Money (integer paise), UUIDv7, domain event + outbox contracts. NO business logic here.</description>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Session 6: shared JWT validation filter, used by every service to enforce
         authentication/authorization consistently (see security/ package). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- JwtAuthFilter implements jakarta.servlet.Filter; spring-security-web only
         depends on the servlet API as "provided", so it doesn't propagate here.
         Every consuming service already brings the real servlet container via
         spring-boot-starter-web. -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Session 6: outbox rows are now relayed to Kafka instead of being polled
         in-process by each consumer — see kafka/OutboxKafkaRelay. This REVERSES the
         earlier "LOCKED DECISION" in DomainEvent.java that dropped Kafka in favor of
         pure DB polling; see CONTEXT.md Session 6 log for the explicit re-flag. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Session 44: image upload (storage/).

         OPTIONAL on purpose. bmp-common is a dependency of all 13 services, and only the ones
         that actually store files need ~12MB of AWS SDK on their classpath. An optional
         dependency is not transitive, so bmp-common compiles S3ObjectStorage against it while
         every service that doesn't ask for it stays unaffected.

         The matching @ConditionalOnClass on S3ObjectStorage means the bean simply isn't
         created where the SDK is absent — so a service without it fails at STARTUP with a
         clear missing-bean message if it tries to inject ObjectStorage, rather than at runtime
         with NoClassDefFoundError on the first upload. Fail early, fail legibly.

         A service that wants uploads adds `software.amazon.awssdk:s3` to its own pom (bmp-salon
         does). Version comes from the BOM in the root pom. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
